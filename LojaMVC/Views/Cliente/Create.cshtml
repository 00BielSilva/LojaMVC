@model LojaMVC.Models.Cliente

@{
    ViewData["Title"] = "Novo Cliente";
}

<div class="container page-container">

    <div class="card">

        <div class="card-header">
            <h4 class="mb-0">Cadastrar Cliente</h4>
        </div>

        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="mb-3">

                    <label asp-for="Nome"
                           class="form-label">
                        Nome
                    </label>

                    <input asp-for="Nome"
                           class="form-control"
                           placeholder="Digite o nome do cliente" />

                    <span asp-validation-for="Nome"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="Email"
                           class="form-label">
                        Email
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Digite o email" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="Idade"
                           class="form-label">
                        Idade
                    </label>

                    <input asp-for="Idade"
                           class="form-control"
                           type="number"
                           placeholder="Digite a idade" />

                    <span asp-validation-for="Idade"
                          class="text-danger">
                    </span>

                </div>


                <div class="form-check mb-4">

                    <input asp-for="Ativo"
                           class="form-check-input" />

                    <label asp-for="Ativo"
                           class="form-check-label">
                        Cliente ativo
                    </label>

                </div>


                <button type="submit"
                        class="btn btn-primary">
                    Cadastrar
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-light ms-2">
                    Voltar
                </a>

            </form>

        </div>

    </div>

</div>