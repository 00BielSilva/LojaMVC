@model LojaMVC.Models.Cliente

@{
    ViewData["Title"] = "Excluir Cliente";
}

<div class="container page-container">

    <div class="card">

        <div class="card-header bg-danger">
            <h4 class="mb-0">Excluir Cliente</h4>
        </div>

        <div class="card-body">

            <h5>Tem certeza que deseja excluir este cliente?</h5>

            <hr />

            <p>
                <strong>Nome:</strong> @Model.Nome
            </p>

            <p>
                <strong>Email:</strong> @Model.Email
            </p>

            <p>
                <strong>Idade:</strong> @Model.Idade
            </p>

            <form asp-action="Delete">

                <input type="hidden"
                       asp-for="Id" />

                <button type="submit"
                        class="btn btn-danger">
                    Sim, excluir
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-light ms-2">
                    Cancelar
                </a>

            </form>

        </div>

    </div>

</div>