@model LojaMVC.Models.Produto

@{
    ViewData["Title"] = "Excluir Produto";
}

<div class="container page-container">

    <div class="card">

        <div class="card-header bg-danger">
            <h4 class="mb-0">Excluir Produto</h4>
        </div>

        <div class="card-body">

            <h5>Tem certeza que deseja excluir este produto?</h5>

            <hr />

            <p>
                <strong>Nome:</strong> @Model.Nome
            </p>

            <p>
                <strong>Preço:</strong>
                R$ @Model.Preco.ToString("F2")
            </p>

            <p>
                <strong>Estoque:</strong> @Model.Estoque
            </p>

            <form asp-action="Delete">

                <input type="hidden"
                       asp-for="Id_produto" />

                <button type="submit"
                        class="btn btn-danger">
                    Sim, excluir
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-light ms-2">
                    Cancelar
                </a>

            </form>

        </div>

    </div>

</div>