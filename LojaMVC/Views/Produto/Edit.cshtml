@model LojaMVC.Models.Produto

@{
    ViewData["Title"] = "Editar Produto";
}

<div class="container page-container">

    <div class="card">

        <div class="card-header">
            <h4 class="mb-0">Editar Produto</h4>
        </div>

        <div class="card-body">

            <form asp-action="Edit">

                <input type="hidden"
                       asp-for="Id_produto" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="mb-3">

                    <label asp-for="Nome"
                           class="form-label">
                        Nome
                    </label>

                    <input asp-for="Nome"
                           class="form-control" />

                    <span asp-validation-for="Nome"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="Preco"
                           class="form-label">
                        Preço
                    </label>

                    <input asp-for="Preco"
                           class="form-control"
                           type="number"
                           step="0.01" />

                    <span asp-validation-for="Preco"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-4">

                    <label asp-for="Estoque"
                           class="form-label">
                        Estoque
                    </label>

                    <input asp-for="Estoque"
                           class="form-control"
                           type="number" />

                    <span asp-validation-for="Estoque"
                          class="text-danger">
                    </span>

                </div>


                <button type="submit"
                        class="btn btn-warning">
                    Salvar Alterações
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-light ms-2">
                    Voltar
                </a>

            </form>

        </div>

    </div>

</div>